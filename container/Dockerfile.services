FROM ghcr.io/astral-sh/uv:0.11.10 AS uv

FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_INSTALL_DIR=/opt/uv-python \
    VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:${PATH}"

WORKDIR /app

COPY --from=uv /uv /usr/local/bin/uv

COPY pyproject.toml uv.lock README.md /app/
COPY proto /app/proto
COPY scripts /app/scripts
COPY src /app/src
COPY examples /app/examples

# scan-fix(docker:S7031): merged consecutive RUN instructions into one layer
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/* \
    && uv venv "${VIRTUAL_ENV}" --python 3.13 \
    && ./scripts/generate_grpc_stubs.sh \
    && uv pip install --python "${VIRTUAL_ENV}/bin/python" -e ".[server,grpc,sklearn]" \
    && useradd --uid 1000 --create-home appuser \
    && chown -R appuser:appuser /app /opt/venv /opt/uv-python
USER appuser

CMD ["python", "-m", "onnx_converter.converter.http_server"]
